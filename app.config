<?xml version="1.0" encoding="utf-8"?>
<!--
  长路径：csc 直接编出来的 exe 没有 TargetFrameworkAttribute，运行库会退回
  legacy 路径处理（>260 的路径连 Path.GetDirectoryName 都会抛 PathTooLongException）。
  这两个开关关掉 legacy 行为，配合 app.manifest 的 longPathAware 与代码里的 \\?\ 前缀，
  才能处理超过 260 的路径。build.ps1 会把它复制成 NewFolderWithSelection.exe.config。
-->
<configuration>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
